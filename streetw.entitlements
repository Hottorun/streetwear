<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The App Group is the only thing the app and the share extension have in common: the
  extension writes a link into the group container, the app drains it. The identifier
  must be identical in both entitlement files — a mismatch is silent, because the
  container URL simply comes back nil and every share disappears without an error.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kern.functional.streetw</string>
	</array>
	<!--
	  Without this key iOS refuses `registerForRemoteNotifications()` outright — the
	  delegate takes the `didFailToRegister` path, no device token is ever issued, and
	  `RemoteSync.pushDeviceToken` is never called. The server then holds device rows with
	  a null token, so `Notifier` finds followers, has nobody to send to, and stamps
	  `notified_at` anyway. Every layer reports healthy and not one notification exists.

	  `development` is correct here even for a build that will ship: Xcode's export step
	  replaces it with `production` using the distribution profile's own entitlement. It
	  matches `BackgroundServices.apnsEnvironment`, which reports "sandbox" for DEBUG, so
	  the token and the host the server sends it to agree.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
