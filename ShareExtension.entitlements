<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Must match streetw.entitlements exactly. The App Group is the only channel between the
  extension and the app, and a mismatched identifier fails silently rather than loudly.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.kern.functional.streetw</string>
	</array>
</dict>
</plist>
